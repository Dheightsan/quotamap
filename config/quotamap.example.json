{
  "_comment": "Example config. Copy to your user config folder with: python scripts/quotamap.py init. Areas are matched in order; the first match wins. keywords are regular expressions tried against the first prompt of a session (lowercase); paths are substrings of the project folder name. Budgets are percent of the weekly quota and do not have to add up to 100.",
  "reset": { "weekday": "sun", "hour_utc": 19 },
  "projects_dir": null,
  "weights": { "opus": 2.0, "sonnet": 1.0, "haiku": 0.33, "fable": 4.0, "default": 1.0 },
  "warn": {
    "min_hours_into_week": 6,
    "projection_margin_pct": 10,
    "area_margin": 1.3,
    "min_area_pct": 2,
    "min_calibration_pct": 3,
    "max_calibration_age_h": 48
  },
  "fallback_area": "other",
  "areas": {
    "frontend": { "budget_pct": 25, "keywords": ["\\bcss\\b", "\\breact\\b", "landing", "\\bui\\b"], "paths": ["webapp", "site"] },
    "backend": { "budget_pct": 30, "keywords": ["\\bapi\\b", "database", "migration", "endpoint"], "paths": ["server"] },
    "docs": { "budget_pct": 10, "keywords": ["\\breadme\\b", "\\bdocs?\\b", "changelog"], "paths": [] },
    "research": { "budget_pct": 10, "keywords": ["investigate", "compare", "research"], "paths": [] },
    "tooling": { "budget_pct": 10, "keywords": ["\\bhooks?\\b", "settings", "\\bmcp\\b", "plugin"], "paths": [] },
    "other": { "budget_pct": 10, "keywords": [] }
  }
}
